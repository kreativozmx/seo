# Local dev: "file:./dev.db" (SQLite). In production (Vercel), this must
# be a Postgres connection string (e.g. from Neon or Supabase) — Vercel's
# filesystem is ephemeral, SQLite doesn't survive between requests there.
DATABASE_URL="file:./dev.db"

# Set this in Vercel's project settings (any random string) to let Vercel
# Cron Jobs authenticate to /api/cron/run-daily — Vercel auto-sends
# "Authorization: Bearer $CRON_SECRET" when this exact env var name is
# set. Leave empty locally; the endpoint allows unauthenticated calls when
# CRON_SECRET isn't configured.
CRON_SECRET=""

# DataForSEO (https://dataforseo.com) — basic auth login/password
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Google Search Console OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gsc/callback"

# Shared Google API key (PageSpeed Insights, Knowledge Graph, Safe Browsing).
# Restrict it in Cloud Console to just those APIs.
GOOGLE_API_KEY=""

# Shopify OAuth app (Partner Dashboard -> Apps -> Create app). Lets
# merchants connect their store's sales in one click, no manual token.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_REDIRECT_URI="http://localhost:3000/api/shopify/callback"

# Where the "Quiero que me ayude un experto" banner links to (mailto,
# WhatsApp, Calendly, contact page — your call). Optional; defaults to a
# mailto if left empty.
NEXT_PUBLIC_EXPERT_CONTACT_URL=""

# OpenAI (https://platform.openai.com) — used to generate AI-improved
# YouTube titles/descriptions in the SEO Youtube tab.
OPENAI_API_KEY=""
