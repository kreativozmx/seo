generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A client or site being tracked
model Project {
  id           String   @id @default(cuid())
  name         String
  domain       String
  locationCode String   @default("2484") // DataForSEO location code, default Mexico
  languageCode String   @default("es")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Public read-only share link (no login) — set when the owner enables
  // sharing for this project; null means sharing is off. Anyone with the
  // token can view (but not edit/connect/delete) this project's dashboard.
  shareToken String? @unique

  // Google Search Console connection (OAuth refresh token + matched property)
  gscRefreshToken String?
  gscSiteUrl      String?
  gscConnectedAt  DateTime?

  // Cached GSC summary (last 28 days), refreshed on demand so the dashboard
  // doesn't have to call the API on every page load.
  gscClicks28d       Int?
  gscImpressions28d  Int?
  gscAvgPosition28d  Float?
  gscStatsUpdatedAt  DateTime?

  // Cached PageSpeed Insights (mobile) for the project's homepage.
  psiPerformanceScore Int?
  psiLcpMs            Int?
  psiCls              Float?
  psiInpMs             Int?
  psiFieldDataSource  String? // "field" (real CrUX data) or "lab" (simulated)
  psiIssuesJson       String? // cached array of {id, title, description, displayValue, score}
  psiUpdatedAt        DateTime?

  // Google Analytics 4 (Data API) connection
  gaRefreshToken String?
  gaPropertyId   String? // numeric GA4 property id, entered manually
  gaConnectedAt  DateTime?

  // Cached GA4 summary (last 28 days)
  gaSessions28d     Int?
  gaUsers28d        Int?
  gaConversions28d  Int?
  gaStatsUpdatedAt  DateTime?

  // GA4 traffic-channel breakdown (last 28 days) — real sessions by
  // channel, including an "AI referral" bucket (chatgpt.com, perplexity.ai,
  // gemini.google.com, etc.) pulled out of GA4's normal Referral channel.
  gaSessionsOrganic28d Int?
  gaSessionsPaid28d    Int?
  gaSessionsDirect28d  Int?
  gaSessionsReferral28d Int?
  gaSessionsAi28d      Int?
  gaChannelsUpdatedAt  DateTime?

  // Merchant-facing GA4 analytics (Analiticas tab) — revenue/orders (only
  // populated if the store has GA4 ecommerce tracking wired up), top pages,
  // top countries, device mix.
  gaRevenue28d          Float?
  gaTransactions28d     Int?
  gaAvgOrderValue28d    Float?
  gaNewUsers28d         Int?
  gaEngagementRate28d   Float?
  gaAvgSessionSec28d    Int?
  gaTopPagesJson        String? // cached array of {path, views}
  gaTopCountriesJson    String? // cached array of {country, sessions}
  gaDeviceBreakdownJson String? // cached {mobile, desktop, tablet}
  gaTopCampaignsJson    String? // cached array of {source, sessions} — source/medium + UTM campaign
  gaTopSourcesJson      String? // cached array of {name, sessions} — source alone
  gaTopMediumsJson      String? // cached array of {name, sessions} — medium alone
  gaSalesByChannelJson     String? // cached array of {label, revenue, transactions, sessions} — GA4's UTM-derived channel grouping
  gaSalesBySourceJson      String? // same shape, by sessionSource
  gaSalesByMediumJson      String? // same shape, by sessionMedium
  gaSalesByLandingPageJson String? // same shape, by landing page — closest proxy to "organic keyword" GA4 exposes
  gaSalesByDeviceJson      String? // same shape, by device category
  gaOrdersByDateJson    String? // cached array of {date, transactions, revenue}
  gaTopProductsJson     String? // cached array of {name, unitsSold, revenue}
  gaAiTrafficSessions28d  Int?
  gaAiTrafficBySourceJson String? // cached array of {label, sessions} — real AI-referred visits (ChatGPT, Perplexity, etc. + UTM tags)
  gaAiLandingPagesJson    String? // cached array of {path, sessions} — pages AI traffic actually lands on
  aiQueryCrossRefJson     String? // cached array of {path, queries:[{query,impressions,clicks,position}]} — real GSC queries for those AI landing pages
  aiQueryCrossRefUpdatedAt DateTime?

  // Estrategia > Contenidos: 12 blog title ideas generated from real GSC
  // queries of the last 7 days, aimed at helping the domain rank.
  contentIdeasJson      String? // cached array of {title, keywords: string[]}
  contentIdeasUpdatedAt DateTime?
  gaAnalyticsUpdatedAt  DateTime?

  // Shopify Admin API (own store only) — one-click OAuth install, not a
  // manually-created access token. Sales data is private and no public
  // API exposes it for anyone else's store, including competitors.
  shopifyShopDomain    String? // resolved xxx.myshopify.com
  shopifyAccessToken   String?
  shopifyRefreshToken  String? // present for expiring offline tokens; used to silently renew shopifyAccessToken
  shopifyTokenExpiresAt DateTime? // null = old-style non-expiring token
  shopifyConnectedAt   DateTime?
  shopifyOrders28d     Int?
  shopifySales28d      Float?
  shopifyCurrency      String?
  shopifySalesUpdatedAt DateTime?

  // Google Business Profile connection. Note: the Business Profile APIs
  // require a Google-approved API access request per Cloud project — this
  // stays unused (403s) until that access is granted.
  gbpRefreshToken String?
  gbpLocationName String? // e.g. "accounts/123456/locations/789"
  gbpConnectedAt  DateTime?

  // Cached Business Profile summary (last 28 days)
  gbpImpressions28d       Int?
  gbpCalls28d             Int?
  gbpWebsiteClicks28d     Int?
  gbpDirectionRequests28d Int?
  gbpStatsUpdatedAt       DateTime?

  // Knowledge Graph — does this brand have a Google Knowledge Panel.
  kgFound       Boolean?
  kgName        String?
  kgDescription String?
  kgImageUrl    String?
  kgScore       Float?
  kgCheckedAt   DateTime?

  // Safe Browsing — is the domain flagged as malicious/phishing.
  safeBrowsingClean     Boolean?
  safeBrowsingThreats   String? // comma-separated threat types, if any
  safeBrowsingCheckedAt DateTime?

  // YouTube channel (SEO Youtube tab) — free, API-key only (YouTube Data API v3).
  youtubeChannelId        String?
  youtubeChannelTitle     String?
  youtubeDescription      String?
  youtubeCountry          String?
  youtubeChannelPublishedAt DateTime?
  youtubeThumbnailUrl     String?
  youtubeSubscribers      Int?
  youtubeViews            Int?
  youtubeVideoCount       Int?
  youtubeRecentVideosJson String? // cached array of recent videos
  youtubeUpdatedAt        DateTime?

  // Ecommerce catalog audit (Ecommerce tab) — free, reads the store's
  // public product endpoints (Shopify /products.json or WooCommerce's
  // Store API), no credentials needed. Reuses the project's own domain.
  ecommercePlatform          String? // "shopify" | "woocommerce" | null
  ecommerceIsShopify         Boolean?
  ecommerceProductCount      Int?
  ecommerceProductCountIsMin Boolean? // true = hit Shopify's 1000-product API cap, real count may be higher
  ecommerceCollectionCount   Int?
  ecommerceCollectionCountIsMin Boolean? // true = hit the 250-collection API cap, real count may be higher
  ecommerceMissingDescCount  Int?
  ecommerceMissingImageCount Int?
  ecommerceMissingAltCount   Int?
  ecommerceThinTitleCount    Int?
  ecommerceFlaggedJson       String? // cached array of flagged products
  ecommercePriceMin          Float?
  ecommercePriceMax          Float?
  ecommerceAvgPrice          Float?
  ecommerceTotalVariants     Int?
  ecommerceTopVendorsJson    String? // cached array of {name, count}
  ecommerceTopTypesJson      String? // cached array of {name, count}
  ecommerceTopTagsJson       String? // cached array of {name, count}
  ecommerceTopSellingJson    String? // cached array of {title, handle} — Shopify only
  ecommerceNewestProductAt   DateTime?
  ecommerceCheckedAt         DateTime?

  // Technology detection (Panel) — Wappalyzer-style: reads the homepage
  // HTML/headers and matches known signatures. Free, no credentials.
  techDetectedJson String? // cached array of {name, category}
  techCheckedAt    DateTime?

  // Estimated organic/paid search visibility for the project's OWN domain
  // (DataForSEO Labs) — same estimate source used for competitors, so both
  // sides of the Competencia comparison chart use comparable numbers.
  domainOrganicKeywords        Int?
  domainOrganicTrafficEstimate Int?
  domainPaidKeywords           Int?
  domainPaidTrafficEstimate    Int?
  domainTrafficValueEstimate   Float?
  domainTrafficCheckedAt       DateTime?

  // Auditoria tab: 50-point Shopify store checklist. Items we can detect
  // automatically from data we already have are computed live (never
  // stored) — this only persists the checkbox state for the
  // recommendation-only items the merchant checks off by hand, as
  // { [itemId]: boolean }.
  auditManualChecksJson String?

  // Apps iOS/Android (DataForSEO App Data API) — search results cached per
  // platform, plus which result (if any) the user marked as "their app".
  appQuery              String? // last search term used
  appsResultsJson        String? // cached { google: [...], apple: [...] }
  appsCheckedAt          DateTime?
  googlePlayAppId        String?
  googlePlayAppTitle     String?
  googlePlayAppIcon      String?
  googlePlayAppRating    Float?
  googlePlayAppReviews   Int?
  googlePlayAppUrl       String?
  appleAppId             String?
  appleAppTitle          String?
  appleAppIcon           String?
  appleAppRating         Float?
  appleAppReviews        Int?
  appleAppUrl            String?

  keywords    Keyword[]
  competitors Competitor[]
}

model Competitor {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domain    String
  name      String?

  // Shopify catalog auto-detected when the competitor is added (same public
  // /products.json read we use for the project's own store).
  ecommerceIsShopify       Boolean?
  ecommerceProductCount    Int?
  ecommerceCollectionCount Int?
  ecommerceCheckedAt       DateTime?

  // Full catalog breakdown (same audit as the project's own Ecommerce tab)
  // — vendors, product types, tags, pricing, and a best-selling approximation
  // via the storefront's own ?sort_by=best-selling.
  ecommercePriceMin        Float?
  ecommercePriceMax        Float?
  ecommerceAvgPrice        Float?
  ecommerceTotalVariants   Int?
  ecommerceTopVendorsJson  String? // cached array of {name, count}
  ecommerceTopTypesJson    String? // cached array of {name, count}
  ecommerceTopTagsJson     String? // cached array of {name, count}
  ecommerceTopSellingJson  String? // cached array of {title, handle}
  ecommerceNewestProductAt DateTime?

  // Estimated organic/paid search visibility (DataForSEO Labs) — an
  // estimate, like SEMrush/Ahrefs show, not real analytics. Nobody outside
  // the site owner can see a competitor's actual traffic or sales.
  organicKeywords         Int?
  organicTrafficEstimate  Int?
  paidKeywords            Int?
  paidTrafficEstimate     Int?
  trafficValueEstimate    Float? // what the organic traffic would cost via ads (USD/mo)
  trafficCheckedAt        DateTime?

  // Technologies detected on the competitor's homepage (same Wappalyzer-
  // style signatures used for the project's own site).
  techDetectedJson String?

  // Keywords this competitor ranks for organically (DataForSEO Labs
  // ranked_keywords), cached as an array of {keyword, position, searchVolume, url}.
  rankedKeywordsJson String?

  @@index([projectId])
}

// A tracked keyword within a project, for a given engine/device. Location and
// language are inherited from the project.
model Keyword {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text       String
  engine     String    @default("google") // google, bing, chatgpt, perplexity, google_ai_overview
  device     String    @default("desktop") // desktop, mobile
  source     String    @default("manual") // manual, planning, gsc
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  rankings   Ranking[]

  @@index([projectId])
}

// A single position measurement for a keyword, for either the project's own
// domain or a tracked competitor domain
model Ranking {
  id          String   @id @default(cuid())
  keywordId   String
  keyword     Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  domain      String
  position    Int? // null = not found in results
  url         String?
  source      String   @default("dataforseo") // dataforseo, gsc, manual
  aiMentioned Boolean? // for AI engines: was the domain/brand mentioned at all
  snippet     String?
  aiOverviewText     String? // text snippet of Google's AI Overview for this keyword, if shown
  aiCitedDomainsJson String? // domains cited inside the AI Overview, as a JSON array
  topResultsJson String? // top-10 organic domains/urls for this SERP snapshot, as a JSON array
  checkedAt   DateTime @default(now())

  @@unique([keywordId, domain, checkedAt, source])
  @@index([keywordId, domain, checkedAt])
}

// One row per run of the daily automatic rank-check job.
model CronRun {
  id             String   @id @default(cuid())
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  keywordsOk     Int      @default(0)
  keywordsFailed Int      @default(0)
  gscProjectsOk  Int      @default(0)
  error          String?
}

// Shopify's own changelog.shopify.com feed, mirrored and translated to
// Spanish (title + a short original summary, not a full reproduction) so
// merchants can see product updates without reading English. Global, not
// per-project — shown in the "Changelog Shopify" tab on every project.
model ShopifyChangelogEntry {
  id          String   @id @default(cuid())
  sourceUrl   String   @unique
  title       String
  titleEs     String
  summaryEs   String
  category    String
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  @@index([publishedAt])
}
